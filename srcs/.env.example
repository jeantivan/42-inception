# ==============================================================================
# INCEPTION - ENVIRONMENT CONFIGURATION FILE
# ==============================================================================

# --- System & Architecture ---
# The version of Alpine Linux to use as the base for all Docker images.
ALPINE_VERSION=3.22

# --- Persistent Storage ---
# The absolute path on the host machine where the data volumes will be stored.
# IMPORTANT: This must match the VOLUME_DIR variable in your Makefile!
VOLUME_DIR=/home/tu_usuario/data

# --- Docker Secrets (File Paths) ---
# Paths to the plain text files containing your sensitive passwords.
# Do NOT type the passwords here, just the path to the files.
# IMPORTANT: These paths must match the REQUIRED_SECRETS in your Makefile!
DB_ROOT_PASSWORD_FILE=../secrets/db_root_password.txt
DB_PASSWORD_FILE=../secrets/db_password.txt
WORDPRESS_ADMIN_PASSWORD_FILE=../secrets/wordpress_admin_password.txt
WORDPRESS_GUEST_PASSWORD_FILE=../secrets/wordpress_guest_password.txt
FTP_PASSWORD_FILE=../secrets/ftp_password.txt

# --- Network & NGINX ---
# The domain name used to access the site (usually your 42 login).
# IMPORTANT: This must match the DOMAIN variable in your Makefile!
DOMAIN_NAME=tu_login.42.fr

# --- MariaDB Configuration ---
# Credentials for the WordPress database.
DB_USERNAME=wp_db_user
DB_NAME=wordpress_db

# --- WordPress Configuration ---
# Setup details for the WordPress installation.
WORDPRESS_SITE_TITLE="Inception 42 Site"
WORDPRESS_ADMIN_USER=wp_admin
WORDPRESS_ADMIN_EMAIL=admin@tu_login.42.fr
WORDPRESS_GUEST_USER=wp_user
WORDPRESS_GUEST_EMAIL=user@tu_login.42.fr

# --- FTP Server Configuration (Bonus) ---
# Username for FTP access to modify WordPress files.
FTP_USER=ftp_user
