---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL || "/";

const btnClass = "text-xl border-2  rounded-sm shadow-md px-6 py-3 text-center";
---

<Layout title="Home">
  <main class="flex flex-col grow justify-center items-center gap-12">
    <div>
      <h1
        class="font-display md:text-8xl text-9xl text-center title select-none"
      >
        {
          "42 - Inception"
            .split("")
            .map((letter) => <span class="title-letter">{letter}</span>)
        }
      </h1>
      <p class="text-center text-2xl mt-4">
        Building custom images and managing virtualized environments for
        advanced system administration.
      </p>
    </div>
    <div class="w-full flex justify-center gap-6 h-fit">
      <a class:list={[btnClass, "btn"]} href={`${base}readme`}>README.md</a>
      <a class:list={[btnClass, "btn"]} href={`${base}user_doc`}>USER_DOC.md</a>
      <a class:list={[btnClass, "btn"]} href={`${base}dev_doc`}>DEV_DOC.md</a>
    </div>
  </main>
</Layout>
