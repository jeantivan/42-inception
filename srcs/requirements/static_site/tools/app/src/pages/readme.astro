---
import Layout from "../layouts/Layout.astro";

import { Content as ReadMeContent } from "../content/README.md";
---

<Layout title="README.md">
  <div class="mx-auto my-12">
    <h1 class="text-8xl font-display mb-4">README.md</h1>
    <div
      class="prose prose-lg prose-slate container p-6 bg-gray-50 rounded-lg shadow-md"
    >
      <ReadMeContent />
    </div>
  </div>
</Layout>
