---
import "@fontsource/gajraj-one";
import "@fontsource/inter";
import "../styles/global.css";

const { title } = Astro.props;
const base = import.meta.env.BASE_URL || "/docs/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Inception</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <nav class="mx-4 flex items-center justify-between p-4">
      <a class="font-display text-2xl font-bold" href={base}>Inception</a>
      <div class="">
        <a href="https://profile-v3.intra.42.fr/users/jtivan-r">jtivan-r</a>
      </div>
    </nav>
    <slot />
  </body>
</html>
